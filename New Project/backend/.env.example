PORT=5000
HOST=0.0.0.0
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (MongoDB Connection String)
# For local: mongodb://localhost:27017/codesyncai
# For Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/codesyncai?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/codesyncai

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# Master Encryption Key (Must be 32+ characters for AES-256-GCM)
MASTER_KEY=your-master-encryption-key-minimum-32-characters

# Code Execution (Disabled by default for safety; set to true only for local dev testing)
EXECUTION_ENABLED=false
